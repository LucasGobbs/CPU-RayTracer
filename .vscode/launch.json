{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pure render (headless)",
      "type": "node-terminal",
      "request": "launch",
      "command": "odin run ./src/ -o:aggressive -microarch:native -no-bounds-check -disable-assert -- --headless scenes/complex.json",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Editor",
      "type": "node-terminal",
      "request": "launch",
      "command": "odin run ./src/ -o:aggressive -microarch:native -no-bounds-check -disable-assert -- scenes/complex.json",
      "cwd": "${workspaceFolder}"
    }
  ]
}
